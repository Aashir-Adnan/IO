# Copy to .env for local overrides. Never commit .env.
IO_DATABASE_URL=postgresql+psycopg://io:io@localhost:5432/io
IO_TEST_DATABASE_URL=postgresql+psycopg://io:io@localhost:5432/io_test

# Opt-in test gates
# IO_OLLAMA_TESTS=1
# IO_ANTHROPIC_TESTS=1

# Only needed when backend.provider is "anthropic" or "hybrid". Use ONE of:
#   ANTHROPIC_API_KEY=sk-ant-...            # a console.anthropic.com API key
#   ANTHROPIC_AUTH_TOKEN=sk-ant-oat01-...   # a Claude subscription token (claude setup-token)
# Embeddings always run locally via Ollama regardless of backend.
